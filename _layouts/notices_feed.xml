---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
{% assign notices = site.notices | sort: "date" | reverse %}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }} Official Notices</title>
    <description>Official notices from the Association Of Indian Go Players.</description>
    <link>{{ "/notices/" | absolute_url }}</link>
    <atom:link href="{{ "/notices/feed.xml" | absolute_url }}" rel="self" type="application/rss+xml" />
    <language>en</language>
    {% for notice in notices limit: 25 %}
    {% include rss-item.xml item=notice %}
    {% endfor %}
  </channel>
</rss>
