---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
{% assign updates = site.news | concat: site.notices | sort: "date" | reverse %}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }} Updates</title>
    <description>Latest news and official notices from the Association Of Indian Go Players.</description>
    <link>{{ "/" | absolute_url }}</link>
    <atom:link href="{{ "/feed.xml" | absolute_url }}" rel="self" type="application/rss+xml" />
    <language>en</language>
    {% for item in updates limit: 30 %}
    {% include rss-item.xml item=item %}
    {% endfor %}
  </channel>
</rss>
